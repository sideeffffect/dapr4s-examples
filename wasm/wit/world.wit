package dapr4s-examples:component;

// Every example component targets the dapr-wasm-components `app` world unchanged, the same world the dapr4s wasm
// layer was generated for. The interfaces package is resolved by `wkg wit fetch --config wkg-config.toml` from OCI
// (ghcr.io/sideeffffect/...), pinned by wkg.lock, and never copied from git: wit/deps/ is git-ignored.
world app {
  include dapr-wasm-components:interfaces/app@0.7.1;
}
